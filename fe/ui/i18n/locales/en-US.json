  "home": {
    "metaTitle": "Home",
    "metaDescription": "NextPT is a private resource community built around quality releases, long-term seeding, and member discussion.",
    "guest": {
      "eyebrow": "A private community for careful collecting and sharing",
      "title": "NextPT",
      "description": "Resources here are not only downloaded. They are organized, supplemented, and kept alive through seeding. Find what you want, then leave something useful for the next member.",
      "primaryAction": "Request access",
      "secondaryAction": "Log in",
      "stats": {
        "privacy": "Curated library",
        "privacyValue": "Organized releases",
        "ratio": "Long-lived access",
        "ratioValue": "Sustained seeding",
        "community": "Member help",
        "communityValue": "Discussion"
      },
      "features": {
        "eyebrow": "Community experience",
        "title": "More than downloading. A place to keep good resources alive.",
        "description": "A good PT community should make quality easier to judge, context easier to find, and seeding after completion feel worth doing."
      },
      "featureItems": {
        "catalog": {
          "title": "Find the right resource faster",
          "description": "Filter by category and keyword, then check descriptions, file trees, size, and activity before downloading."
        },
        "tracker": {
          "title": "Older resources still matter",
          "description": "The community encourages long-term seeding and reseeds so useful releases can stay available after the initial rush."
        },
        "ratio": {
          "title": "Sharing has feedback",
          "description": "Upload, download, seed time, and bonus history are reflected in the user center, so steady contribution is visible."
        },
        "forum": {
          "title": "Discussion around resources",
          "description": "When versions, subtitles, reseeds, or usage questions come up, the forum gives members a place to add context."
        },
        "subtitle": {
          "title": "Subtitles and notes stay visible",
          "description": "Browse, download, and report subtitles separately, while descriptions and issue notes stay easier for later members to find."
        },
        "account": {
          "title": "A quieter sharing environment",
          "description": "Clear rules for joining, publishing, downloading, and interaction reduce noise and make the community easier to use long-term."
        }
      },
      "flow": {
        "eyebrow": "How it works",
        "title": "From joining to contributing",
        "description": "The everyday path is simple: join the site, find resources, keep seeding, and participate in the community.",
        "items": {
          "invite": {
            "title": "Join the community",
            "description": "Enter through an invite or open registration, learn the rules, then start browsing and saving resources."
          },
          "discover": {
            "title": "Find resources",
            "description": "Search the catalog, filter categories, and inspect descriptions, file trees, and interactions."
          },
          "seed": {
            "title": "Download and seed",
            "description": "Connect your torrent client to the tracker, then keep seeding after completion to build contribution."
          },
          "discuss": {
            "title": "Join the community",
            "description": "Ask questions, report issues, add subtitles, and take part in forum discussions."
          }
        }
      },
      "faq": {
        "eyebrow": "FAQ",
        "title": "Common questions",
        "items": {
          "invite": {
            "question": "Do I need an invite code?",
            "answer": "That depends on the current site configuration. If the registration page asks for an invite code, enter one if you have it; otherwise you can submit according to the site rules."
          },
          "ratio": {
            "question": "Why does ratio matter?",
            "answer": "Private trackers depend on users continuing to upload and seed. Ratio helps keep resources available and gives users a clear view of their contribution."
          },
          "passkey": {
            "question": "Can I share download links with others?",
            "answer": "You should not share personal download links or torrent files outside the site. Private trackers rely on account-based activity, and leaking links can affect your account and sharing data."
        },
        "forum": {
            "question": "Can I request resources or report issues?",
            "answer": "Yes. The forum is a good place for requests, resource feedback, subtitle notes, and rule discussion. Good feedback helps resources stay useful longer."
          }
        }
      },
      "cta": {
        "title": "Ready to enter the community?",
        "description": "After creating an account, you can browse resources, save favorites, join discussions, and become part of the sharing cycle from your first download."
      }
    },
    "member": {
      "eyebrow": "Site workspace",
      "title": "Welcome back, {name}",
      "description": "This is your signed-in home for jumping into resources, forums, and your user center.",
